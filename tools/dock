#!/bin/sh
# Run a command inside the ror-build image with the repo mounted at /work.
#   tools/dock ninja
#   tools/dock python3 tools/configure.py
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DOCKER="$(command -v docker || echo "$HOME/.docker/bin/docker")"
[ -x "$DOCKER" ] || DOCKER="/c/Program Files/Docker/Docker/resources/bin/docker.exe"
# Git Bash: docker.exe wants C:/... volume paths, not /c/...
command -v cygpath >/dev/null 2>&1 && ROOT="$(cygpath -m "$ROOT")"
TTY=""
[ -t 0 ] && [ -t 1 ] && TTY="-it"
# Git Bash rewrites container paths like /work into C:/Program Files/Git/work;
# we already passed a native path for the volume, so turn that off entirely.
export MSYS_NO_PATHCONV=1
export MSYS2_ARG_CONV_EXCL='*'
# The old 32-bit compilers hit EOVERFLOW on the Windows bind mount; tell
# ee-cc to compile from a copy on the container's own filesystem.
MIRROR=""
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) MIRROR="-e EE_CC_MIRROR=1" ;; esac
if [ -n "$EE_CC_MIRROR" ]; then MIRROR="-e EE_CC_MIRROR=$EE_CC_MIRROR"; fi
exec "$DOCKER" run --rm $TTY --platform linux/amd64 $MIRROR \
  -v "$ROOT":/work -w /work ror-build "$@"
